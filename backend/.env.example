# Copy this file to backend/.env and add your own key.
# backend/.env is git-ignored and is read only by the Python server.

GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOURCE_MAX_CHARS=160000
MAX_ANSWER_CHARS=40000
MAX_PDF_BYTES=8388608
MAX_REQUEST_BYTES=15728640
